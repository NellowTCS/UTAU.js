    "jest-environment-jsdom": "^30.4.1",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "@nisoku/satori": "^0.1.3",
    "@sevenc-nanashi/utaformatix-ts": "npm:@jsr/sevenc-nanashi__utaformatix-ts@^0.4.0"
